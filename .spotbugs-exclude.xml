<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtre SpotBugs pour VOX — supprime le bruit vérifié, garde le reste.

  Vérifié le 2026-10-06 (scan complet, 9 High / 82 Medium) :
  - EI / EI2 (« expose internal representation ») : systématique sur les data
    classes Kotlin à ByteArray/Collection. Non actionnable.
  - ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD : les champs visés sont des
    singletons dont le champ est explicitement @Volatile (SmsBridge,
    SmsNotifier, WearBridge). Délibéré, pas un bug.

  NON exclus volontairement : les règles SEC* de find-sec-bugs (SSRF, path
  traversal, XML, unicode). Elles ont été revues comme déjà mitigées, mais elles
  restent visibles pour qu'un futur changement réel ne passe pas sous le radar.
-->
<FindBugsFilter>
  <Match>
    <Bug pattern="EI,EI2,EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    <Class name="~chat\.fluffy\.fluffychat\.(sms\.(SmsBridge|SmsNotifier)|wear\.WearBridge).*"/>
  </Match>
</FindBugsFilter>
